---
// Reading progress for the manifesto, in the site's native dialect:
// block characters. Appears only while the essay is on screen.
---

<div class="read-progress" id="read-progress" aria-hidden="true" hidden></div>

<script>
  const el = document.getElementById('read-progress');
  const prose = document.querySelector('#manifesto .prose');
  const BAR = 10;

  if (el && prose) {
    let ticking = false;

    function update() {
      ticking = false;
      const rect = prose.getBoundingClientRect();
      const winH = window.innerHeight;
      const total = rect.height;
      const read = Math.min(Math.max(winH - rect.top, 0), total);
      const pct = total > 0 ? read / total : 0;

      const inView = rect.top < winH * 0.75 && rect.bottom > winH * 0.35;
      el.hidden = !inView;
      if (!inView) return;

      const fill = Math.round(pct * BAR);
      el.textContent = `reading ${'█'.repeat(fill)}${'░'.repeat(BAR - fill)} ${Math.round(pct * 100)}%`;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
