---
import archetypesData from '../data/quiz/archetypes.json';
const archetypes = archetypesData.archetypes;
---

<section id="quiz" class="section">
  <div class="wrap">
    <p class="kicker">find your linux</p>
    <div class="quiz-head">
      <h2>Not a horoscope. A blueprint.</h2>
      <p>
        Twelve questions, two minutes, zero typing. You do not get told which distro you "are". You get a complete build for <em>your</em> machine and <em>your</em> life: distro, desktop, gaming layer, an escape plan for that one Windows app, plus a copy-paste prompt that makes the AI of your choice walk you through the whole installation.
      </p>
    </div>

    <div class="quiz-stage">
      <div class="tui" id="quiz-tui">
        <div class="tui-bar">
          <span>find-your-linux</span>
          <span id="quiz-step" role="status">ready</span>
        </div>
        <div class="tui-body" id="quiz-app" aria-live="polite">
          <noscript>
            <p class="question">
              The quiz needs JavaScript, the only JavaScript on this site, and it
              apologizes. Meanwhile, you can browse the ten archetypes below.
            </p>
          </noscript>
        </div>
      </div>
      <p class="hint quiz-kbd" id="quiz-kbd" hidden>
        keys: <kbd>1</kbd>–<kbd>4</kbd> answer · <kbd>↑</kbd><kbd>↓</kbd> move ·
        <kbd>enter</kbd> confirm · <kbd>esc</kbd> back
      </p>
    </div>

    <p class="quiz-note">
      The questions, the archetypes and every scoring weight are plain JSON in the
      public repo, verified by a brute-force harness across all 16,777,216 possible
      answer combinations. When the quiz tells someone to install Arch, you can
      open a pull request about it.
    </p>

    <p class="quiz-note">
      Impatient? The ten archetypes:
      {archetypes.map((a, i) => (
        <span><a href={`/r/${a.slug}/`}>{a.name}</a>{i < archetypes.length - 1 ? ' · ' : ''}</span>
      ))}
    </p>
  </div>
</section>

<script>
  import { rank, encodeAnswers } from '../lib/engine.js';
  import questionsData from '../data/quiz/questions.json';
  import archetypesData from '../data/quiz/archetypes.json';

  const questions = questionsData.questions;
  const archetypes = archetypesData.archetypes;
  const Q = questions.length;
  const BAR = 14;

  const app = document.getElementById('quiz-app');
  const step = document.getElementById('quiz-step');
  const kbdHint = document.getElementById('quiz-kbd');

  let idx = -1; // -1 = intro
  let hi = 0; // highlighted option
  const answers = [];

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  }

  function progress() {
    const fill = Math.round((idx / Q) * BAR);
    return '█'.repeat(fill) + '░'.repeat(BAR - fill);
  }

  function render() {
    if (idx === -1) {
      step.textContent = 'ready';
      kbdHint.hidden = true;
      app.innerHTML = `
        <p class="question">Twelve questions. No typing. No wrong answers, only consequences.</p>
        <div class="tui-actions">
          <span></span>
          <button class="btn btn-primary" id="quiz-start">[ start ]</button>
        </div>`;
      document.getElementById('quiz-start').addEventListener('click', start);
      return;
    }
    if (idx >= Q) return; // redirecting

    const q = questions[idx];
    step.textContent = `question ${idx + 1}/${Q}`;
    kbdHint.hidden = false;
    app.innerHTML = `
      <p class="question">${esc(q.prompt)}</p>
      <div class="opts" role="radiogroup" aria-label="${esc(q.prompt)}">
        ${q.options
          .map(
            (o, i) => `
          <button class="opt${i === hi ? ' hi' : ''}" role="radio"
            aria-checked="${answers[idx] === i}" data-i="${i}">
            <span class="opt-key">(${i + 1})</span> ${esc(o.label)}
          </button>`
          )
          .join('')}
      </div>
      <p class="tui-progress" aria-hidden="true"><span class="fill">${progress()}</span> ${idx + 1}/${Q}</p>
      <div class="tui-actions">
        <button class="btn" id="quiz-back" ${idx === 0 ? 'disabled' : ''}>[ esc back ]</button>
        <span class="hint">pick one to continue</span>
      </div>`;

    app.querySelectorAll('.opt').forEach((btn) => {
      btn.addEventListener('click', () => choose(Number(btn.dataset.i)));
    });
    const back = document.getElementById('quiz-back');
    if (back) back.addEventListener('click', goBack);
  }

  function start() {
    idx = 0;
    hi = 0;
    render();
  }

  function goBack() {
    if (idx > 0) {
      idx--;
      hi = answers[idx] ?? 0;
      render();
    }
  }

  function choose(i) {
    answers[idx] = i;
    // brief visual confirmation, then advance
    const btn = app.querySelector(`.opt[data-i="${i}"]`);
    if (btn) {
      app.querySelectorAll('.opt').forEach((b) => b.setAttribute('aria-checked', 'false'));
      btn.setAttribute('aria-checked', 'true');
    }
    setTimeout(() => {
      idx++;
      hi = answers[idx] ?? 0;
      if (idx >= Q) finish();
      else render();
    }, 160);
  }

  function finish() {
    step.textContent = 'computing…';
    const result = rank(answers, questions, archetypes);
    const a = encodeAnswers(answers);
    window.location.href = `/r/${result.winner.slug}/?a=${a}`;
  }

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (idx === -1) {
      if (e.key === 'Enter' && document.activeElement === document.getElementById('quiz-start')) return;
      return;
    }
    if (idx >= Q) return;
    if (e.key >= '1' && e.key <= '4') {
      e.preventDefault();
      choose(Number(e.key) - 1);
    } else if (e.key === 'ArrowDown' || e.key === 'j') {
      e.preventDefault();
      hi = Math.min(3, hi + 1);
      render();
    } else if (e.key === 'ArrowUp' || e.key === 'k') {
      e.preventDefault();
      hi = Math.max(0, hi - 1);
      render();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      choose(hi);
    } else if (e.key === 'Escape' || e.key === 'Backspace') {
      e.preventDefault();
      goBack();
    }
  });

  render();
</script>
