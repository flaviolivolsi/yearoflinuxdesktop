---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import ShellOverlay from '../components/ShellOverlay.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
}

const {
  title = 'The Year of the Linux Desktop',
  description = 'It never arrives. It never will. It was never going to be a year on a calendar. It arrives one person at a time.',
  canonicalPath = '/',
  ogImage,
} = Astro.props;

const canonical = `https://yearoflinuxdesktop.org${canonicalPath}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Flavio Li Volsi" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={`https://yearoflinuxdesktop.org${ogImage}`} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101310" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f5ef" />
    <meta name="generator" content={Astro.generator} />
    <script
      data-goatcounter="https://flaviolivolsi.goatcounter.com/count"
      async src="//gc.zgo.at/count.js"></script>
    <script is:inline>
      // Rice, read before paint to avoid a flash. 'auto' follows the system;
      // everything else is a named theme. Yes, the site is themeable.
      // That is the entire thesis wearing a small hat.
      try {
        const t = localStorage.getItem('theme');
        if (t && t !== 'auto') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <!--
      Hello, view-source person. You are the target audience.

      Static site. No trackers, no cookies, no fingerprinting, no external
      requests. The JavaScript budget went to a quiz, some rice, and a fake
      terminal. We regret nothing.

      Everything here is open source, including the quiz weights,
      which live in a JSON file you can argue about in a pull request.

      Also: press ~
    -->
    <a class="skip-link" href="#main">skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="prompt">$</span> year-of-the-linux-desktop</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/#manifesto">manifesto</a>
          <a href="/#quiz">quiz</a>
          <a href="https://github.com/flaviolivolsi/yearoflinuxdesktop">source</a>
          <div class="rice-wrap">
            <button class="theme-toggle" id="theme-toggle" aria-expanded="false" aria-haspopup="true" aria-label="Rice the site: change color theme" title="rice the site">
              <span class="rice-dot" aria-hidden="true"></span> rice ▾
            </button>
            <div class="rice-menu" id="rice-menu" hidden data-rice-chips></div>
          </div>
        </nav>
      </div>
    </header>
    <script is:inline>
      (() => {
        // name -> [bg, accent, ink] swatch colors. The palettes live in CSS;
        // these dots are just the menu's preview.
        const PAL = {
          auto: ['#101310', '#c6dc72', '#f6f5ef'],
          light: ['#f6f5ef', '#55671c', '#1e211b'],
          dark: ['#101310', '#c6dc72', '#e7e9e1'],
          gruvbox: ['#282828', '#b8bb26', '#ebdbb2'],
          catppuccin: ['#1e1e2e', '#cba6f7', '#cdd6f4'],
          nord: ['#2e3440', '#88c0d0', '#eceff4'],
          tokyonight: ['#1a1b26', '#7aa2f7', '#c0caf5'],
          dracula: ['#282a36', '#50fa7b', '#f8f8f2'],
        };
        window.yoldThemes = PAL;
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const menu = document.getElementById('rice-menu');

        function current() {
          try {
            const t = localStorage.getItem('theme');
            return PAL[t] ? t : 'auto';
          } catch {
            return 'auto';
          }
        }

        function renderChips() {
          document.querySelectorAll('[data-rice-chips]').forEach((box) => {
            box.innerHTML = '';
            for (const name of Object.keys(PAL)) {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'rice-chip' + (name === current() ? ' active' : '');
              b.innerHTML =
                PAL[name].map((c) => `<span class="dot" style="background:${c}"></span>`).join('') +
                `<span>${name}</span>`;
              b.addEventListener('click', () => {
                window.yoldSetTheme(name);
                if (!menu.hidden) toggleMenu(false);
              });
              box.appendChild(b);
            }
            if (box === menu) {
              const x = document.createElement('button');
              x.type = 'button';
              x.className = 'rice-chip rice-close';
              x.textContent = '✕ close';
              x.addEventListener('click', () => toggleMenu(false));
              box.appendChild(x);
            }
          });
        }

        window.yoldSetTheme = (t) => {
          if (!PAL[t]) return;
          if (t === 'auto') delete root.dataset.theme;
          else root.dataset.theme = t;
          try {
            localStorage.setItem('theme', t);
          } catch {}
          btn.setAttribute('aria-label', `Rice the site. Current: ${t}`);
          renderChips();
        };

        function toggleMenu(show) {
          const s = show ?? menu.hidden;
          menu.hidden = !s;
          btn.setAttribute('aria-expanded', String(s));
        }

        btn.setAttribute('aria-label', `Rice the site. Current: ${current()}`);
        btn.addEventListener('click', () => toggleMenu());
        // pointerdown, not click: iOS does not reliably deliver document
        // clicks from taps on non-interactive areas.
        document.addEventListener('pointerdown', (e) => {
          if (!menu.hidden && !menu.contains(e.target) && !btn.contains(e.target)) toggleMenu(false);
        });
        window.addEventListener('scroll', () => {
          if (!menu.hidden) toggleMenu(false);
        }, { passive: true });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hidden) toggleMenu(false);
        });
        renderChips();
        document.addEventListener('DOMContentLoaded', renderChips);
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
    <ShellOverlay />
  </body>
</html>
