---
import Base from '../../layouts/Base.astro';
import archetypesData from '../../data/quiz/archetypes.json';
import { personalize } from '../../lib/engine.js';

export function getStaticPaths() {
  return archetypesData.archetypes.map((a) => ({
    params: { slug: a.slug },
    props: { archetype: a },
  }));
}

const { archetype } = Astro.props;
const generic = personalize(archetype, {});
const title = `${archetype.name} · The Year of the Linux Desktop`;
const canonical = `https://yearoflinuxdesktop.org/r/${archetype.slug}/`;
---

<Base
  title={title}
  description={archetype.tagline}
  canonicalPath={`/r/${archetype.slug}/`}
  ogImage={`/og/${archetype.slug}.png`}
>
  <section class="section result-section">
    <div class="wrap narrow">
      <p class="kicker">your blueprint</p>

      <div class="tui blueprint" id="result" data-slug={archetype.slug}>
        <div class="tui-bar">
          <span>your-blueprint</span>
          <span>{archetype.name.toLowerCase()}</span>
        </div>
        <div class="tui-body">
          {archetype.sigil && <pre class="sigil" aria-hidden="true">{archetype.sigil.join('\n')}</pre>}
          <h1>{archetype.name}</h1>
          <p class="tagline">{archetype.tagline}</p>
          <dl class="spec" id="bp-rows">
            {generic.rows.map((r) => (
              <div><dt>{r.k}</dt><dd>{r.v}</dd></div>
            ))}
          </dl>
          {archetype.alt && (
            <p class="alt"><span>second opinion ·</span> {archetype.alt}</p>
          )}
          <p class="annoy" id="bp-annoy">
            <strong>What will still annoy you:</strong> {generic.annoy.join(' ')}
          </p>
          <div id="bp-notes" class="notes"></div>
        </div>
      </div>

      <div class="share-row">
        <button class="btn" id="share-result">[ copy link to this result ]</button>
        <button class="btn" id="card-download">[ download your card ]</button>
      </div>

      <div class="prompt-block" id="prompt-block" hidden>
        <p class="kicker" style="margin: 3rem 0 1rem;">your setup prompt</p>
        <p class="prompt-lead">
          Paste this into the LLM of your choice. It contains your hardware, your
          skill level and your blueprint. The AI walks you through the switch,
          one step at a time, and debugs with you when something breaks.
        </p>
        <textarea
          id="prompt-text"
          readonly
          rows="14"
          spellcheck="false"
          aria-label="Your personalized setup prompt"></textarea>
        <div class="prompt-actions">
          <button class="btn btn-primary" id="copy-prompt">[ copy your setup prompt ]</button>
          <a class="btn" href="/#hardware" id="hw-link" hidden>[ you said you need hardware → ]</a>
        </div>
      </div>

      <div class="prompt-block" id="generic-cta">
        <p class="prompt-lead">
          This is the generic {archetype.name} blueprint.
          <a href="/#quiz">Take the quiz</a> to personalize it with your hardware, your
          Windows anchors, your terminal comfort, and to get a copy-paste setup
          prompt that makes an AI install it with you.
        </p>
      </div>

      <p class="result-foot">
        <a href="/#quiz">↻ take the quiz</a> ·
        <a href="/#hardware">the hardware</a> ·
        <a href="/">the manifesto</a>
      </p>
    </div>
  </section>
</Base>

<script>
  import {
    computeProfile,
    personalize,
    buildPrompt,
    decodeAnswers,
    rank,
  } from '../../lib/engine.js';
  import questionsData from '../../data/quiz/questions.json';
  import archetypesData from '../../data/quiz/archetypes.json';

  const questions = questionsData.questions;
  const container = document.getElementById('result');
  const slug = container?.dataset.slug;
  const archetype = archetypesData.archetypes.find((a) => a.slug === slug);

  const a = new URLSearchParams(window.location.search).get('a');
  const answers = decodeAnswers(a, questions.length);

  // The card renders in whatever rice you are currently wearing.
  const cardBtn = document.getElementById('card-download');
  cardBtn.addEventListener('click', () => {
    const css = getComputedStyle(document.documentElement);
    const v = (name) => css.getPropertyValue(name).trim();
    const W = 1200;
    const H = 630;
    const cv = document.createElement('canvas');
    cv.width = W;
    cv.height = H;
    const ctx = cv.getContext('2d');
    const mono = '"Cascadia Code", "JetBrains Mono", Menlo, monospace';
    const serif = 'Georgia, serif';

    ctx.fillStyle = v('--bg');
    ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = v('--line');
    ctx.lineWidth = 2;
    ctx.strokeRect(16, 16, W - 32, H - 32);
    ctx.fillStyle = v('--accent');
    ctx.fillRect(16, 16, 6, H - 32);

    ctx.fillStyle = v('--muted');
    ctx.font = `22px ${mono}`;
    ctx.fillText('YOUR LINUX ARCHETYPE', 64, 84);

    if (archetype.sigil) {
      ctx.fillStyle = v('--accent');
      ctx.font = `20px ${mono}`;
      archetype.sigil.forEach((line, i) => ctx.fillText(line, 950, 70 + i * 24));
    }

    ctx.fillStyle = v('--ink');
    ctx.font = `bold 72px ${serif}`;
    ctx.fillText(archetype.name, 60, 170);

    ctx.fillStyle = v('--muted');
    ctx.font = `26px ${mono}`;
    // wrap tagline
    const words = archetype.tagline.split(' ');
    let line = '';
    let y = 224;
    for (const w of words) {
      if (ctx.measureText(line + w).width > 1050) {
        ctx.fillText(line, 60, y);
        line = '';
        y += 34;
      }
      line += w + ' ';
    }
    ctx.fillText(line.trim(), 60, y);
    y += 56;

    const rows = Array.from(document.querySelectorAll('#bp-rows > div'))
      .map((d) => [d.querySelector('dt')?.textContent || '', d.querySelector('dd')?.textContent || ''])
      .slice(0, 5);
    ctx.font = `24px ${mono}`;
    for (const [k, val] of rows) {
      ctx.fillStyle = v('--muted');
      ctx.fillText(k + ' ·', 60, y);
      ctx.fillStyle = v('--ink');
      ctx.fillText(val.length > 62 ? val.slice(0, 59) + '…' : val, 320, y);
      y += 40;
    }

    ctx.fillStyle = v('--muted');
    ctx.font = `20px ${mono}`;
    ctx.fillText('not a horoscope. a blueprint.', 60, H - 52);
    ctx.fillStyle = v('--accent');
    ctx.fillText('$ yearoflinuxdesktop.org', W - 340, H - 52);

    const link = document.createElement('a');
    link.download = `yold-${slug}.png`;
    link.href = cv.toDataURL('image/png');
    link.click();
    cardBtn.textContent = '[ saved ✓ ]';
    setTimeout(() => (cardBtn.textContent = '[ download your card ]'), 2600);
  });

  const shareBtn = document.getElementById('share-result');
  shareBtn.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      window.prompt('Copy this link:', url);
    }
    shareBtn.textContent = '[ copied ✓ ]';
    setTimeout(() => (shareBtn.textContent = '[ copy link to this result ]'), 2600);
  });

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  }

  // Answers must actually produce this page's archetype. A shared or edited
  // URL whose answers rank differently (including after recalibrations)
  // redirects to the true winner instead of presenting a false result.
  if (answers && archetype) {
    const winner = rank(answers, questions, archetypesData.archetypes).winner;
    if (winner.slug !== slug) {
      window.location.replace(`/r/${winner.slug}/?a=${a}`);
    }
  }

  if (answers && archetype) {
    try { window.goatcounter?.count({ path: `quiz-complete--${slug}`, event: true }); } catch {}
    const { axes, gates } = computeProfile(answers, questions);
    const { rows, annoy, notes } = personalize(archetype, gates);

    document.getElementById('bp-rows').innerHTML = rows
      .map((r) => `<div><dt>${esc(r.k)}</dt><dd>${esc(r.v)}</dd></div>`)
      .join('');
    document.getElementById('bp-annoy').innerHTML =
      `<strong>What will still annoy you:</strong> ${esc(annoy.join(' '))}`;
    document.getElementById('bp-notes').innerHTML = notes
      .map((n) => `<p class="note">↳ ${esc(n)}</p>`)
      .join('');

    const prompt = buildPrompt(archetype, gates, axes, rows);
    const ta = document.getElementById('prompt-text');
    ta.value = prompt;
    document.getElementById('prompt-block').hidden = false;
    document.getElementById('generic-cta').hidden = true;
    if (gates.machine === 'none') {
      document.getElementById('hw-link').hidden = false;
    }

    const btn = document.getElementById('copy-prompt');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt);
      } catch {
        ta.select();
        document.execCommand('copy');
      }
      btn.textContent = '[ copied ✓ · now paste it into your AI ]';
      setTimeout(() => (btn.textContent = '[ copy your setup prompt ]'), 2600);
    });
  }
</script>
